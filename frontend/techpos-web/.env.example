# VietQR — tài khoản nhận chuyển khoản của cửa hàng.
# Sao chép file này thành `.env` (đã gitignore) rồi điền giá trị thật.
# bankBin: mã BIN ngân hàng theo chuẩn NAPAS (vd Vietcombank 970436, BIDV 970418, Techcombank 970407).
VITE_VIETQR_BANK_BIN=
VITE_VIETQR_ACCOUNT=
VITE_VIETQR_TEMPLATE=compact2
VITE_VIETQR_ADDINFO=HNPOS